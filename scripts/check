#!/usr/bin/env bash
# Run all site checks: the build checks and the converter unit tests, under
# uv Python 3.12. Runs both suites even if the first fails; exits non-zero if
# either did. Set REQUIRE_NODE=1 to fail (not skip) when node is missing.
# Usage: scripts/check
set -uo pipefail
cd "$(dirname "$0")/.."
status=0
uv run --no-project --python 3.12 tests/check_site.py         || status=1
uv run --no-project --python 3.12 tests/test_notes_to_post.py || status=1
exit $status
